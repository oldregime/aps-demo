    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "siteOptions": {
    "blogname": "Agri Phero Solutionz",
    "blogdescription": "Protecting Crop \u2022 Creating Life"
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "polylang"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "fluentform"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "seo-by-rank-math"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/oldregime/aps-demo/a8366a3f45060530cfce35af9822c6c61ccaa80b/aps-core-plugin.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/oldregime/aps-demo/a8366a3f45060530cfce35af9822c6c61ccaa80b/aps-corporate-theme.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "mkdir",
