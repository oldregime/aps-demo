    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/aps-seed/aps-logo.png",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/oldregime/aps-demo/a8366a3f45060530cfce35af9822c6c61ccaa80b/scripts/aps-logo.png"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/aps-seed/provision-pages.php",
