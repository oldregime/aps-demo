        "resource": "url",
        "url": "https://raw.githubusercontent.com/oldregime/aps-demo/a8366a3f45060530cfce35af9822c6c61ccaa80b/scripts/provision-pages.php"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/aps-seed/provision.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/oldregime/aps-demo/a8366a3f45060530cfce35af9822c6c61ccaa80b/scripts/provision.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\n$S = '/wordpress/wp-content/aps-seed';\nregister_shutdown_function( function () use ( $S ) { $e = error_get_last(); if ( $e ) file_put_contents( \"$S/last-error.txt\", print_r( $e, true ), FILE_APPEND ); } );\nrequire '/wordpress/wp-load.php';\nif ( ! class_exists( 'WP_CLI' ) ) { class WP_CLI { static function log( $m ) { file_put_contents( '/wordpress/wp-content/aps-seed/log.txt', \"LOG $m\\n\", FILE_APPEND ); } static function warning( $m ) { file_put_contents( '/wordpress/wp-content/aps-seed/log.txt', \"WARN $m\\n\", FILE_APPEND ); } static function success( $m ) { file_put_contents( '/wordpress/wp-content/aps-seed/log.txt', \"OK $m\\n\", FILE_APPEND ); } static function error( $m ) { throw new Exception( $m ); } } }\nupdate_option( 'permalink_structure', '/%postname%/' );\nwp_set_current_user( 1 );\n@set_time_limit( 0 );\nforeach ( [ 'provision-pages', 'seed-home', 'seed-forms', 'seed-pages', 'provision' ] as $f ) {\n\ttry { include \"$S/$f.php\"; file_put_contents( \"$S/log.txt\", \"DONE $f\\n\", FILE_APPEND ); }\n\tcatch ( Throwable $t ) { file_put_contents( \"$S/log.txt\", \"FAIL $f: \" . $t->getMessage() . ' @ ' . $t->getFile() . ':' . $t->getLine() . \"\\n\", FILE_APPEND ); }\n}\nflush_rewrite_rules();\n"
    }
  ]
